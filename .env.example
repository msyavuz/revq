# GitHub token. Read access is enough for triage; posting reviews and labels
# needs pull_requests:write (fine-grained) or repo/public_repo (classic).
GITHUB_TOKEN=

# Claude Code auth, one of:
#   subscription: run `claude setup-token` on any machine and paste the token
#   API billing:  set ANTHROPIC_API_KEY instead
CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_API_KEY=

# Basic-auth password for the UI (any username). Set this if the port is
# reachable by anything other than you.
REVQ_PASSWORD=
